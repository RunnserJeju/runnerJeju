# infra/.env 로 복사해서 실제 값을 채운다. infra/.env는 git에 안 올라간다.
#
# 팀 공유 개발 DB(Supabase 등)를 쓸 때만 필요하다. 비워두면 docker-compose.yml의
# 기본값(로컬 db 컨테이너, --profile local-db)을 그대로 쓴다.
#
# Supabase 기준: Project Settings → Database → Connection string 에서 값을 가져오되,
# SQLAlchemy가 쓰도록 스킴을 postgresql+psycopg:// 로 바꿔야 한다.
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# 배너 이미지 업로드(Supabase Storage)용. DB 접속과 무관한 API 키라 접두사를 나눠 둔다
# (DATABASE_* = DB 접속, SUPABASE_* = Supabase API).
# SUPABASE_URL은 위 DATABASE_URL과 같은 project-ref를 쓴다.
#
# SUPABASE_API_SECRET_KEY는 Project Settings → API Keys 에서 만드는 sb_secret_... 키다.
# 모든 Storage 권한 정책을 무시하니(BYPASSRLS) 절대 앱(클라이언트)에 넣지 않는다 —
# 서버 환경변수로만 존재해야 한다.
# 예전 service_role 키도 아직 동작하지만 2026년 말 폐기 예정이고, 2025-11 이후
# 만들어진 프로젝트에는 아예 발급되지 않는다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_API_SECRET_KEY=<sb_secret_... secret key>

# 배너 이미지를 올릴 Storage 버킷 이름. 버킷은 Public으로 만들어야 앱에서 볼 수 있다.
SUPABASE_STORAGE_BUCKET=banners

# 로그인 토큰 서명 키. 없으면 서버가 기동을 거부한다(app/config_guard.py) —
# 개발과 운영이 같은 이미지를 쓰는데 이것만 빠뜨려도 조용히 뜨기 때문이다.
# 개발용과 운영용을 다른 값으로 두면, 개발 토큰이 운영에서 통하지 않는다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<위 명령으로 생성한 값>
