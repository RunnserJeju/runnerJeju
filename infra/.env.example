# infra/.env 로 복사해서 실제 값을 채운다. infra/.env는 git에 안 올라간다.
#
# 팀 공유 개발 DB(Supabase 등)를 쓸 때만 필요하다. 비워두면 docker-compose.yml의
# 기본값(로컬 db 컨테이너, --profile local-db)을 그대로 쓴다.
#
# Supabase 기준: Project Settings → Database → Connection string 에서 값을 가져오되,
# SQLAlchemy가 쓰도록 스킴을 postgresql+psycopg:// 로 바꿔야 한다.
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# 배너 이미지 업로드(Supabase Storage)용. Project Settings → API 에서 가져온다.
# SUPABASE_URL은 위 DATABASE_URL의 db.<project-ref>.supabase.co와 같은 project-ref를 쓴다.
#
# SUPABASE_SERVICE_ROLE_KEY는 모든 Storage 권한 정책을 무시하는 마스터 키다.
# 절대 앱(클라이언트)에 넣지 않는다 — 서버 환경변수로만 존재해야 한다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret>

# 배너 이미지를 올릴 Storage 버킷 이름. 버킷은 Public으로 만들어야 앱에서 볼 수 있다.
SUPABASE_STORAGE_BUCKET=banners
