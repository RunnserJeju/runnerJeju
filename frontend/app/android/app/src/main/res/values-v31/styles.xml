<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+는 windowBackground 대신 시스템 스플래시를 먼저 그린다.
         그 배경색을 브랜드 레드로 맞춰야 흰 화면이 한 번 튀지 않는다.
         아이콘은 런처 아이콘을 그대로 쓴다 — 아이콘 배경도 같은 레드라 자연스럽게 이어진다. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_red</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
