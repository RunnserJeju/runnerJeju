# android/key.properties 로 복사해서 실제 값을 채운다. key.properties는 git에 안 올라간다.
#
# 릴리즈 키스토어는 앱당 하나를 팀이 공유한다(각자 만드는 게 아니다). 키스토어
# 파일(.jks)과 아래 비밀번호는 안전한 곳에 함께 보관/공유한다 — 잃어버리면 같은
# 앱으로 업데이트를 못 올린다.
#
# 키스토어 생성:
#   keytool -genkeypair -v -keystore frontend/app/android/runners-jeju-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias runners-jeju

# storeFile은 android/app/ 기준 상대경로다(Gradle file()이 app 모듈에서 해석).
# 키스토어를 android/ 레벨에 두면 ../ 를 붙인다.
storeFile=../runners-jeju-release.jks
storePassword=<키스토어 비밀번호>
keyAlias=runners-jeju
keyPassword=<키 비밀번호>
